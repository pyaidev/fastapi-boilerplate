APP_ENV=development
APP_NAME=fastapi-boilerplate
DEBUG=false
SECRET_KEY=CHANGE_ME_SECRET
OUTBOX_ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY
DATABASE_URL=postgresql+asyncpg://fastapi:CHANGE_ME_DB_PASSWORD@db:5432/fastapi
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ORIGINS=[]
TRUSTED_PROXY_IPS=[]
PUBLIC_BASE_URL=http://localhost:8002
DOCS_ENABLED=true
API_PORT=8002
JWT_ISSUER=fastapi-boilerplate
JWT_AUDIENCE=fastapi-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RATE_IP=1000/minute
RATE_USER=600/minute
RATE_LOGIN=5/minute
RATE_REGISTER=5/hour
RATE_RESET=5/hour
RATE_REFRESH=30/minute
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
MAILPIT_PORT=8026
POSTGRES_DB=fastapi
POSTGRES_USER=fastapi
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_PORT=3001
PROMETHEUS_PORT=9091
SENTRY_DSN=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
